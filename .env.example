# ============================================================================
# USE CASE ARMS RACE - ENVIRONMENT CONFIGURATION
# ============================================================================
#
# IMPORTANT: Copy this file to .env.local and fill in your actual values.
# DO NOT commit .env.local to git (already in .gitignore)
#
# Required for:
# - Supabase CLI (local development + deployment)
# - Edge functions (Deno runtime)
# - Test suites (Deno test)
# - Admin scripts (database operations)
#
# ============================================================================

# ----------------------------------------------------------------------------
# STAGING ENVIRONMENT
# ----------------------------------------------------------------------------

# Supabase staging project
# Get these from: https://app.supabase.com/project/[your-staging-ref]/settings/api
SUPABASE_URL_STAGING=https://your-staging-ref.supabase.co
SUPABASE_ANON_KEY_STAGING=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY_STAGING=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Database connection string (for direct psql access)
# Get from: Supabase Dashboard → Project Settings → Database → Connection String
DATABASE_URL_STAGING=postgresql://postgres:[password]@db.[your-staging-ref].supabase.co:5432/postgres

# ----------------------------------------------------------------------------
# PRODUCTION ENVIRONMENT
# ----------------------------------------------------------------------------

# Supabase production project
# Get these from: https://app.supabase.com/project/[your-prod-ref]/settings/api
SUPABASE_URL_PROD=https://your-prod-ref.supabase.co
SUPABASE_ANON_KEY_PROD=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY_PROD=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Database connection string (production)
DATABASE_URL_PROD=postgresql://postgres:[password]@db.[your-prod-ref].supabase.co:5432/postgres

# ----------------------------------------------------------------------------
# DEFAULT ENVIRONMENT (used by Supabase CLI)
# ----------------------------------------------------------------------------

# Point these to staging for development, production for deployment
SUPABASE_URL=$SUPABASE_URL_STAGING
SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY_STAGING
SUPABASE_SERVICE_ROLE_KEY=$SUPABASE_SERVICE_ROLE_KEY_STAGING

# ----------------------------------------------------------------------------
# BUFFER API (Phase SHOW)
# ----------------------------------------------------------------------------

# Buffer access token for show distribution
# Get from: https://account.buffer.com/developers → Create App → Access Token
BUFFER_ACCESS_TOKEN=your-buffer-access-token-here

# Buffer profile IDs (get after connecting profiles)
# Run: curl https://api.bufferapp.com/1/profiles.json?access_token=YOUR_TOKEN
BUFFER_PROFILE_YOUTUBE=
BUFFER_PROFILE_TIKTOK=
BUFFER_PROFILE_LINKEDIN=

# ----------------------------------------------------------------------------
# FEATURE FLAGS (Phase 0+)
# ----------------------------------------------------------------------------

# Enable/disable features without code changes
# Set these in Supabase Dashboard → Edge Functions → Secrets as well

# Phase U1: Feed timeline (Latest, Top, Under Fire, Flips tabs)
FLAG_FEED=false

# Phase U2: Automatic verification via AI
FLAG_AUTOVERIFY=false

# Phase U3: User complaints and review queue
FLAG_COMPLAINTS=false

# Phase EBL-1: Card minting v2 with procedural backgrounds
FLAG_MINT_V2=false

# Phase SHOW: Daily show distribution via Buffer
FLAG_SHOW=false

# ----------------------------------------------------------------------------
# OPTIONAL: LOCAL DEVELOPMENT
# ----------------------------------------------------------------------------

# Local Supabase (if running supabase start)
# SUPABASE_URL=http://localhost:54321
# SUPABASE_ANON_KEY=[printed by supabase start]
# SUPABASE_SERVICE_ROLE_KEY=[printed by supabase start]

# ----------------------------------------------------------------------------
# TESTING
# ----------------------------------------------------------------------------

# Override for test runs (set to staging or dedicated test project)
# TEST_SUPABASE_URL=
# TEST_SUPABASE_ANON_KEY=
# TEST_SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------------
# MONITORING & OBSERVABILITY
# ----------------------------------------------------------------------------

# Sentry DSN (optional, for error tracking)
# SENTRY_DSN=

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# ECONOMY TUNING (override defaults from config/economy.ts)
# ----------------------------------------------------------------------------

# Rate limiting (requests per minute per user)
# RATE_LIMIT_DEFAULT=30
# RATE_LIMIT_SUBMIT=5
# RATE_LIMIT_VOTE=60

# Reputation thresholds (unlock privileges)
# REP_THRESHOLD_SUBMIT=0
# REP_THRESHOLD_STEWARD=100

# Card minting parameters
# FACTION_FLIP_HYSTERESIS=0.05
# ALIGNMENT_SYNC_HOUR=2

# ----------------------------------------------------------------------------
# NOTES
# ----------------------------------------------------------------------------

# 1. Never commit .env.local to git
# 2. Service role keys are SECRET - only use server-side
# 3. Anon keys are PUBLIC - safe to expose in frontend
# 4. Use staging for all development and testing
# 5. Only deploy to production after staging tests pass
# 6. Feature flags allow instant rollback without redeployment
# 7. Refer to DEPLOYMENT_GUIDE.md for setup instructions
